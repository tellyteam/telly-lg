{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Major updates wait for a tick on the Dependency Dashboard issue, rather than opening a PR each",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The GitHub Actions' minor and patch updates in one PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Svelte and its tooling in one PR",
      "matchPackageNames": ["svelte", "svelte-check", "@sveltejs/**", "@tsconfig/svelte"],
      "groupName": "Svelte"
    },
    {
      "description": "Vite and Vitest in one PR",
      "matchPackageNames": ["vite", "vitest", "@vitest/**"],
      "groupName": "Vite"
    }
  ]
}
